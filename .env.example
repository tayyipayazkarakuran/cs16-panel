# CS 1.6 Panel – Environment Variables
# Copy this file to .env and fill in your values

# Your server's public IP address (for FastDL sv_downloadurl)
HOST_IP=127.0.0.1

# Game server hostname (used for public server connect links)
GAME_SERVER_HOST=localhost

# Host listeners (change these locally when another app already uses a port)
PANEL_BIND_HOST=0.0.0.0
PANEL_HOST_PORT=3000
PANEL_ADDITIONAL_ORIGINS=
FASTDL_BIND_HOST=0.0.0.0
FASTDL_HOST_PORT=8080
PHP_BIND_HOST=0.0.0.0
PHP_HOST_PORT=8081
BHOP_BIND_HOST=0.0.0.0
BHOP_HOST_PORT=8082

# Host directories mounted into panel, FastDL, PHP, and game containers
FASTDL_HOST_PATH=/opt/cspanel/fastdl-data
PHP_WWW_HOST_PATH=/opt/cspanel/php-www

# Optional upload limits (bytes)
MAX_UPLOAD_BYTES=268435456
MAX_FOLDER_BATCH_BYTES=100663296
MAX_MAP_BYTES=268435456
MAX_PLUGIN_BYTES=16777216

# Destructive rental/reset/delete/expiry/pool-repair actions are blocked here
PROTECTED_SERVER_PORTS=27015,27016

# MySQL root password
MYSQL_ROOT_PASSWORD=cs_root_2024

# Host-side MySQL listener; use 3307 locally if 3306 is already occupied
MYSQL_BIND_HOST=0.0.0.0
MYSQL_HOST_PORT=3306

# Panel authentication (always replace these in production)
PANEL_AUTH_SECRET=replace-with-a-long-random-secret
PANEL_TOKEN_TTL_SECONDS=86400
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
PANEL_USER_USERNAME=user
PANEL_USER_PASSWORD=replace-with-a-strong-user-password

# Bhop website database password
BHOP_DB_PASS=changeme
