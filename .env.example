# ---------------------------------------------------------------
#  CS 1.6 Panel – environment (copy to .env and edit)
# ---------------------------------------------------------------
NODE_ENV=production

# Public address of this host (shown to players, used for FastDL/PHP defaults)
HOST_IP=203.0.113.10
GAME_SERVER_HOST=203.0.113.10

# Panel URL as users open it (cookies, CORS and login links use it)
PANEL_PUBLIC_URL=https://panel.example.com
# Extra origins allowed to call the API (comma separated)
PANEL_ADDITIONAL_ORIGINS=

# Required. Root password of the bundled MySQL container.
MYSQL_ROOT_PASSWORD=change-this-to-a-long-random-password

# Session signing secret (48+ random chars). Leave empty to let the panel
# generate one and keep it in the database.
PANEL_AUTH_SECRET=

# First-boot accounts. Only created if they do not exist yet.
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=change-me-now
PANEL_USER_USERNAME=demo
PANEL_USER_PASSWORD=change-me-too

# FastDL (GoldSrc clients download over plain HTTP)
FASTDL_PORT=8080
# FASTDL_PUBLIC_URL=http://fastdl.example.com

# PHP websites: <base>/<port>/  or a {port} template for wildcard subdomains
PHP_PUBLIC_BASE_URL=http://203.0.113.10:8081
# PHP_PUBLIC_BASE_URL=https://php-{port}.example.com

# MySQL is bound to 127.0.0.1 by default. To let customers use remote SQL
# tools, expose it and advertise the address:
# MYSQL_BIND_HOST=0.0.0.0
# MYSQL_PUBLIC_HOST=203.0.113.10

# Host paths for shared data
FASTDL_HOST_PATH=/opt/cspanel/fastdl-data
PHP_WWW_HOST_PATH=/opt/cspanel/php-www
UPLOADS_HOST_PATH=/opt/cspanel/uploads

# Destructive operations (reset/delete/rent) are blocked on these ports
PROTECTED_SERVER_PORTS=27015,27016

# Host listeners (change locally when another app already uses a port)
PANEL_BIND_HOST=0.0.0.0
PANEL_HOST_PORT=3000
FASTDL_BIND_HOST=0.0.0.0
FASTDL_HOST_PORT=8080
PHP_BIND_HOST=0.0.0.0
PHP_HOST_PORT=8081
MYSQL_HOST_PORT=3306
BHOP_BIND_HOST=0.0.0.0
BHOP_HOST_PORT=8082

# Session lifetime and brute-force protection
PANEL_TOKEN_TTL_SECONDS=86400
PANEL_MAX_FAILED_LOGINS=8
PANEL_LOCKOUT_MINUTES=15

# Optional upload limits (bytes)
MAX_UPLOAD_BYTES=268435456
MAX_FOLDER_BATCH_BYTES=100663296
MAX_MAP_BYTES=268435456
MAX_PLUGIN_BYTES=16777216
MAX_SITE_ZIP_BYTES=134217728

# Bhop website database password
BHOP_DB_PASS=changeme
